{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "User",
    "description": "Schema for user documents in Firestore",
    "type": "object",
    "properties": {
      "email": {
        "description": "The user's email address",
        "type": "string",
        "format": "email"
      },
      "display_name": {
        "description": "The user's display name",
        "type": "string"
      },
      "photo_url": {
        "description": "Path or URL to the user's profile photo",
        "type": "string"
      },
      "uid": {
        "description": "The user's unique identifier",
        "type": "string"
      },
      "created_time": {
        "description": "The time when the user account was created",
        "type": "string",
        "format": "date-time"
      },
      "phone_number": {
        "description": "The user's phone number",
        "type": "string"
      },
      "birthday": {
        "description": "The user's date of birth",
        "type": "string",
        "format": "date-time"
      },
      "addr_address": {
        "description": "The user's street address",
        "type": "string"
      },
      "addr_city": {
        "description": "The city of the user's address",
        "type": "string"
      },
      "addr_state": {
        "description": "The state of the user's address",
        "type": "string"
      },
      "addr_zip": {
        "description": "The zip code of the user's address",
        "type": "integer"
      }
    },
    "required": ["email", "display_name", "uid", "created_time"]
  }